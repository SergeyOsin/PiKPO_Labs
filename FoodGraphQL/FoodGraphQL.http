@FoodGraphQL_HostAddress = http://localhost:5013

POST {{FoodGraphQL_HostAddress}}/graphql
Content-Type: application/json

{
  "query": "query { foodProducts(take: 10, isVegan: true) { id name calories category isVegan } }"
}
###

POST {{FoodGraphQL_HostAddress}}/graphql
Content-Type: application/json

{
  "query": "query($id: String!) { foodProductById(id: $id) { id name calories protein carbs fats category isVegan isVegetarian createdAt } }",
  "variables": {
    "id": "REPLACE_WITH_PRODUCT_ID"
  }
}
###
